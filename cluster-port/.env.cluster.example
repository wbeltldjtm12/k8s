# Container runtime
KUBEINSIGHT_ENV=prod

# Gemini OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=replace-with-your-gemini-api-key
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=0
LLM_MAX_OUTPUT_TOKENS=1600
LLM_RAG_MAX_DOCS=1
LLM_RAG_MAX_CHARS_PER_DOC=950
LLM_QUOTA_MAX_RETRIES=3
LLM_QUOTA_MAX_WAIT_SECONDS=600
LLM_QUOTA_WAIT_GRACE_SECONDS=3

# Prometheus NodePort on the Kubernetes master
PROMETHEUS_URL=http://192.168.0.12:30090
PROMETHEUS_REQUEST_TIMEOUT_SECONDS=3

# Disabled by default: the published API-only baseline must remain unchanged.
# Enable only after cluster-port/network-probe is installed and Prometheus is scraping it.
KUBEIN_NETWORK_EVIDENCE_ENABLED=false
KUBEIN_NETWORK_EVIDENCE_REQUIRED=true
KUBEIN_NETWORK_PROBE_EXPECTED_WORKLOADS=shipping,payment,front-end
KUBEIN_NETWORK_PROBE_LATENCY_SECONDS=0.5
KUBEIN_NETWORK_PROBE_WINDOW_SECONDS=45
KUBEIN_NETWORK_PROBE_MAX_SAMPLE_AGE_SECONDS=10
KUBEIN_NETWORK_PROBE_MAX_OBSERVATION_AGE_SECONDS=8
KUBEIN_NETWORK_PROBE_MIN_SAMPLES=2
